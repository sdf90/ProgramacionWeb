
@using ProgramacionWeb.Models;
@model List<MarcaCLS>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

@*Agregar un boton con estilos*@
@Html.ActionLink("Agregar","Agregar","Marca",null,new { @class = "btn btn-primary"})

<table class="table table-bordered table-hover">

    <thead>
        <tr>
            <td width="10%">@Html.LabelFor(p=>Model[0].iidmarca)</td>
            <td width="20%">@Html.LabelFor(p=>Model[0].nombre)</td>
            <td width="60%">@Html.LabelFor(p=>Model[0].descripcion)</td>  
            <td width="10%">Operaciones</td>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
        <tr>
            <td>@item.iidmarca</td>
            <td>@item.nombre</td>
            <td>@item.descripcion</td>
         
            <td>@Html.ActionLink(" ", "Editar", "Marca", new { id = @item.iidmarca }, new { @class = "glyphicon glyphicon-edit btn btn-primary" })
            @Html.ActionLink(" ", "Eliminar", "Marca", new { id = @item.iidmarca }, new { @class = "glyphicon glyphicon-trash btn btn-danger", @onclick="eliminar()" })</td>


        </tr>

        }

    </tbody>



</table>

<script>
    function eliminar() {
        if (confirm("¿Desea eliminar el registro realmente") == 1) {
            //Pone si
            alert("Se eliminó correctamente");
        } else {
            //Le quita la acción del evento para eliminar la marca
            event.preventDefault();
        }
    }
</script>